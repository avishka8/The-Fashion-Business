---
import Base from "../layouts/Base.astro";
import news from "../../content/news/index.json";
import * as weekly from "../articles/weekly.md";
const latest = news[0];
const list = news.slice(0, 30);
const day = (d) => (d ? new Date(d).toLocaleDateString("en-IN", { day: "numeric", month: "short" }) : "");
const title = "The Fashion Business";
---
<Base title="The Fashion Business">
  <script is:inline>
    if (sessionStorage.getItem("tfb-intro")) document.documentElement.classList.add("skip-intro");
    else sessionStorage.setItem("tfb-intro", "1");
  </script>

  <div id="intro" aria-hidden="true">
    <div class="intro-inner">
      <span class="intro-line"></span>
      <div class="intro-title">{[...title].map((c, i) => <span style={`--i:${i}`}>{c === " " ? "\u00a0" : c}</span>)}</div>
      <span class="intro-line"></span>
    </div>
  </div>

  <section id="home" class="section hero">
    <img class="flower" style="left:-2vw;top:8%" src="/img/flower-left.png" alt="" onerror="this.style.display='none'" />
    <img class="flower" style="right:-2vw;top:4%" src="/img/flower-right.png" alt="" onerror="this.style.display='none'" />
    <img class="flower" style="left:38%;top:42%;width:min(26vw,320px)" src="/img/flower-mid.png" alt="" onerror="this.style.display='none'" />
    <div class="hero-in">
      <div class="wing-slot"><img src="/img/wing-line.png" alt="" onerror="this.style.display='none'" /></div>
      <h1>The Fashion Business</h1>
      <a class="btn" href="/join">join now</a>
    </div>
  </section>

  <section class="section split">
    <img class="flower" style="left:-3vw;top:-2%;width:min(24vw,300px)" src="/img/flower-left.png" alt="" onerror="this.style.display='none'" />
    <img class="flower" style="left:30%;bottom:-8%;width:min(26vw,340px)" src="/img/flower-mid.png" alt="" onerror="this.style.display='none'" />
    <img class="flower" style="right:-5vw;top:8%;width:min(26vw,340px)" src="/img/flower-right.png" alt="" onerror="this.style.display='none'" />
    <div class="reveal">
      <p class="eyebrow">{latest ? `${latest.category} · ${day(latest.created_at)}` : "Latest"}</p>
      <h2 class="title">{latest ? latest.headline : "News Headline"}</h2>
      <div class="orn"></div>
      <p class="lead">{latest ? latest.summary : "Fresh stories on Indian fashion business appear here automatically."}</p>
      <p><a class="more" href="#news">More news →</a></p>
    </div>
    <aside class="week reveal">
      <h3>Article of the Week</h3>
      <p class="wt">{weekly.frontmatter.title}</p>
      <a class="btn" href="/article">Read Now</a>
    </aside>
  </section>

  <section id="newsletter" class="section center">
    <img class="flower" style="left:-3vw;top:10%" src="/img/flower-left.png" alt="" onerror="this.style.display='none'" />
    <img class="flower" style="right:-3vw;top:10%" src="/img/flower-right.png" alt="" onerror="this.style.display='none'" />
    <div class="reveal">
      <p class="eyebrow">The weekly letter</p>
      <h2 class="title">Indian fashion business,<br />in your inbox every week</h2>
      <div class="orn" style="max-width:420px;margin-inline:auto"></div>
      <p class="lead">Funding, retail, D2C and craft economics, plus one long read. No noise.</p>
      <a class="btn" href="/join">Subscribe</a>
    </div>
  </section>

  <section id="news" class="section">
    <img class="flower" style="left:-3vw;top:6%" src="/img/flower-left.png" alt="" onerror="this.style.display='none'" />
    <div class="reveal"><p class="eyebrow">Updated automatically</p><h2 class="title">News list</h2><div class="orn"></div></div>
    <div class="cards">
      {list.length === 0 && <p class="lead">No stories published yet. Check back soon.</p>}
      {list.map((n) => (
        <article class="card reveal">
          <p class="eyebrow">{n.category} · {day(n.created_at)}</p>
          <h3>{n.headline}</h3>
          <p>{n.summary}</p>
          <p class="src">{n.sources.map((s) => <a href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a>)}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="contact" class="section center">
    <img class="flower" style="left:-4vw;bottom:4%;width:min(24vw,300px)" src="/img/flower-left.png" alt="" onerror="this.style.display='none'" />
    <img class="flower" style="right:-4vw;top:6%;width:min(24vw,300px)" src="/img/flower-right.png" alt="" onerror="this.style.display='none'" />
    <div class="reveal" style="max-width:560px;margin:auto">
      <p class="eyebrow">Reach out</p><h2 class="title">Contact</h2><div class="orn"></div>
      <form id="contact-form">
        <input name="name" placeholder="Your name" required /><input name="email" type="email" placeholder="Email" required />
        <textarea name="msg" rows="4" placeholder="Your message" required></textarea>
        <button class="btn" type="submit">Send</button>
      </form>
    </div>
  </section>

  <script>
    // Opens the visitor's mail app. Change the address below to your own.
    const TO = "hello@example.com";
    document.getElementById("contact-form")?.addEventListener("submit", (e) => {
      e.preventDefault();
      const f = new FormData(e.target as HTMLFormElement);
      location.href = `mailto:${TO}?subject=${encodeURIComponent("Message from " + f.get("name"))}&body=${encodeURIComponent(f.get("msg") + "\n\n" + f.get("email"))}`;
    });
  </script>
</Base>

<style is:global>
  .hero { min-height:calc(100vh - 64px); display:grid; place-items:center; text-align:center }
  .hero-in { max-width:900px }
  .wing-slot { height:56px; display:flex; justify-content:center; align-items:flex-end }
  .wing-slot img { max-height:56px }
  .hero h1 { font-family:var(--serif); font-weight:400; font-size:clamp(2.6rem,8vw,5.8rem); line-height:1.05; margin:6px 0 34px; }
  .split { display:grid; grid-template-columns:1.4fr 1fr; gap:6vw; align-items:center }
  .lead { max-width:560px; color:#2a2723; font-size:1.1rem; margin-bottom:18px }
  .center { text-align:center } .center .lead { margin-inline:auto }
  .more { border-bottom:1px solid #000; padding-bottom:2px }
  .week { border:1px solid #111; outline:1px solid #111; outline-offset:-7px; border-radius:14px; padding:48px 28px; text-align:center; background:rgba(255,255,255,.7); backdrop-filter:blur(2px) }
  .week h3 { font-size:1.5rem; font-weight:600 } .wt { font-size:1.7rem; font-weight:600; line-height:1.25; margin:44px 0 52px }
  .cards { display:grid; grid-template-columns:repeat(auto-fill,minmax(290px,1fr)); gap:22px }
  .card { background:rgba(255,255,255,.85); border:1px solid #e4dccf; padding:26px; transition:transform .35s, box-shadow .35s }
  .card:hover { transform:translateY(-4px); box-shadow:0 14px 30px rgba(0,0,0,.08) }
  .card h3 { font-family:var(--serif); font-size:1.5rem; font-weight:500; line-height:1.2; margin:8px 0 10px }
  .src { margin-top:12px; font-size:.85rem; display:flex; flex-wrap:wrap; gap:6px 14px } .src a { color:var(--mute); border-bottom:1px solid #ccc }
  #contact-form { display:grid; gap:12px; text-align:left } #contact-form .btn { justify-self:center }
  /* intro animation */
  #intro { position:fixed; inset:0; z-index:100; background:#000; color:#fff; display:grid; place-items:center; animation:curtain 1.1s 3.1s cubic-bezier(.77,0,.18,1) forwards }
  .intro-inner { text-align:center } .skip-intro #intro { display:none }
  .intro-title { font-family:var(--serif); font-size:clamp(2rem,7vw,4.6rem); margin:16px 0; white-space:nowrap }
  .intro-title span { display:inline-block; opacity:0; transform:translateY(40px); filter:blur(6px); animation:rise .9s calc(.5s + var(--i) * .07s) cubic-bezier(.2,.8,.2,1) forwards }
  .intro-line { display:block; height:1px; width:min(60vw,520px); margin:auto; background:#fff; transform:scaleX(0); animation:draw 1.2s .2s ease forwards }
  @keyframes rise { to { opacity:1; transform:none; filter:none } }
  @keyframes draw { to { transform:scaleX(1) } }
  @keyframes curtain { to { transform:translateY(-100%); visibility:hidden } }
  .hero-in > * { animation:fadeup 1s 3.5s both } .skip-intro .hero-in > * { animation-delay:0s }
  @keyframes fadeup { from { opacity:0; transform:translateY(18px) } }
  @media (max-width:800px) { .split { grid-template-columns:1fr } .flower { opacity:.5 } .intro-title { white-space:normal } }
  @media (prefers-reduced-motion:reduce) { #intro { display:none } .hero-in > * { animation:none } }
</style>