---
const { title = "The Fashion Business" } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="nav">
    <a class="logo" href="/"><img src="/img/logo-wing.png" alt="" onerror="this.style.display='none'" /><span>TFB</span></a>
    <nav>
      <a href="/#home">home</a><a href="/#newsletter">newsletter</a><a href="/#news">news list</a><a href="/article">article</a><a href="/#contact">contact</a>
    </nav>
    <a class="join" href="/join">Join Now</a>
  </header>
  <slot />
  <footer><span>© The Fashion Business</span><span><span>Made by Avishka Srivastava ♡</span></span></footer>
  <script>
    const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add("in"), io.unobserve(e.target))), { threshold: 0.12 });
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
  </script>
</body>
</html>
<style is:global>
  :root { --ink:#0b0b0b; --cream:#f1dcc0; --paper:#fff; --mute:#5c5750; --serif:"Cormorant Garamond",serif; --sans:"Jost",system-ui,sans-serif; }
  * { box-sizing:border-box; margin:0; padding:0 }
  html { scroll-behavior:smooth; scroll-padding-top:70px }
  body { font-family:var(--sans); color:var(--ink); background:var(--paper); line-height:1.65; overflow-x:hidden }
  a { color:inherit; text-decoration:none }
  .nav { position:sticky; top:0; z-index:50; height:64px; background:#000; color:#fff; display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:24px; padding:0 4vw }
  .nav .logo { justify-self:start }
  .nav .join { justify-self:end }
  @media (max-width:760px) { .nav { grid-template-columns:auto 1fr auto } .nav nav { justify-self:center; min-width:0 } }
  .nav nav { display:flex; gap:clamp(16px,3vw,44px); font-size:1.05rem; overflow-x:auto; white-space:nowrap }
  .nav nav a, .join { position:relative; padding:4px 0 }
  .nav nav a::after { content:""; position:absolute; left:0; bottom:0; height:1px; width:100%; background:#fff; transform:scaleX(0); transform-origin:left; transition:transform .35s }
  .nav nav a:hover::after { transform:scaleX(1) }
  .logo { display:flex; flex-direction:column; align-items:center; font-family:var(--serif); font-size:1.6rem; line-height:1 }
  .logo img { height:12px; filter:invert(1) }
  .join { font-weight:500; white-space:nowrap }
  .btn { display:inline-block; background:#000; color:#fff; padding:12px 30px; font-size:1.15rem; font-weight:500; border:0; cursor:pointer; transition:transform .3s, background .3s }
  .btn:hover { transform:translateY(-2px); background:#222 }
  .section { position:relative; padding:clamp(70px,10vw,120px) 6vw; overflow:hidden }
  .section > *:not(.flower) { position:relative; z-index:1 }
  .flower { position:absolute; z-index:0; pointer-events:none; width:min(30vw,380px); opacity:.95 }
  .eyebrow { font-size:.8rem; letter-spacing:.28em; text-transform:uppercase; color:var(--mute) }
  h2.title { font-family:var(--serif); font-weight:400; font-size:clamp(2.2rem,5vw,3.6rem); line-height:1.1; margin:10px 0 18px }
  .orn { height:10px; margin:12px 0 20px; background:linear-gradient(#000,#000) center/100% 1px no-repeat; position:relative }
  .orn::before,.orn::after { content:""; position:absolute; top:1px; width:8px; height:8px; background:#000; transform:rotate(45deg) }
  .orn::before { left:0 } .orn::after { right:0 }
  .reveal { opacity:0; transform:translateY(24px); transition:opacity .9s ease, transform .9s ease }
  .reveal.in { opacity:1; transform:none }
  footer { background:#000; color:#bbb; display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px; padding:22px 6vw; font-size:.85rem }
  input, textarea { width:100%; font:inherit; padding:12px 14px; border:1px solid #cfc7bb; background:#fff; outline:0; transition:border .2s }
  input:focus, textarea:focus { border-color:#000 }
  @media (prefers-reduced-motion:reduce) { html { scroll-behavior:auto } .reveal { opacity:1; transform:none; transition:none } }
</style>